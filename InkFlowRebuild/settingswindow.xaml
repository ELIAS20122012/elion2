<Window x:Class="InkFlow.SettingsWindow" Icon="elion.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="elion Settings" Height="680" Width="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="12" xmlns:inkflow="clr-namespace:InkFlow;assembly=InkFlow">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- elion Gold theme -->
      <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2DC9E" Offset="0" />
        <GradientStop Color="#D4AF5F" Offset="0.55" />
        <GradientStop Color="#A87F3A" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="DarkBtnBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B3E45" Offset="0" />
        <GradientStop Color="#25272C" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BtnBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.2" />
        <GradientStop Color="#00C9A24E" Offset="0.8" />
        <GradientStop Color="#66C9A24E" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GoldBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.2" />
        <GradientStop Color="#00000000" Offset="0.8" />
        <GradientStop Color="#40000000" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GoldFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#9A7333" Offset="0" />
        <GradientStop Color="#D4AF5F" Offset="1" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="GoldKnob" GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#F6E2A6" Offset="0" />
        <GradientStop Color="#B8913F" Offset="1" />
      </RadialGradientBrush>
      <LinearGradientBrush x:Key="GoldIcon" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6E2A6" Offset="0" />
        <GradientStop Color="#D4AF5F" Offset="0.5" />
        <GradientStop Color="#9A7333" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="SectionDivider" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#66D4AF5F" Offset="0" />
        <GradientStop Color="#14D4AF5F" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="MutedText" Color="#BDB9B0" />
      <SolidColorBrush x:Key="HintText" Color="#9E9A91" />
      <SolidColorBrush x:Key="Fg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentFg" Color="#1C1D21" />
      <SolidColorBrush x:Key="AccentRing" Color="#00000000" />
      <SolidColorBrush x:Key="BtnFg" Color="#E6C77E" />
      <SolidColorBrush x:Key="BtnBorder" Color="#00000000" />
      <SolidColorBrush x:Key="BtnRing" Color="#00000000" />
      <SolidColorBrush x:Key="FieldBg" Color="#141518" />
      <SolidColorBrush x:Key="FieldFg" Color="#D8D4CA" />
      <SolidColorBrush x:Key="CtlBg" Color="#141518" />
      <SolidColorBrush x:Key="CtlBorder" Color="#4A4D55" />
      <SolidColorBrush x:Key="TrackBg" Color="#121316" />
      <SolidColorBrush x:Key="AccentText" Color="#E6C77E" />
      <SolidColorBrush x:Key="WinBorder" Color="#00000000" />
      <SolidColorBrush x:Key="WinRing" Color="#00000000" />
      <LinearGradientBrush x:Key="WinBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#25272C" Offset="0" />
        <GradientStop Color="#1D1E22" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WinBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0FFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.1" />
        <GradientStop Color="#00C9A24E" Offset="0.9" />
        <GradientStop Color="#4DC9A24E" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource DarkBtnBg}" />
        <Setter Property="Foreground" Value="{DynamicResource BtnFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnRing}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Tag" Value="{DynamicResource BtnBevel}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="17" BorderThickness="1" BorderBrush="{DynamicResource BtnBorder}">
                  <UIElement.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.55" />
                  </UIElement.Effect>
                </Border>
                <Border CornerRadius="17" BorderThickness="0,1,0,1" BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False" />
                <Border CornerRadius="15" Margin="2.5" BorderThickness="0.8" BorderBrush="{TemplateBinding Control.BorderBrush}" IsHitTestVisible="False" />
                <Border Name="Hi" CornerRadius="17" Background="#1AFFFFFF" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Hi" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Hi" Property="Background" Value="#26000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GoldButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentRing}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Tag" Value="{DynamicResource GoldBevel}" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="FieldBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource FieldBg}" />
        <Setter Property="Foreground" Value="{DynamicResource FieldFg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" BorderThickness="0,1,0,1">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D9000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.3" />
                    <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                  <Ellipse Fill="{DynamicResource CtlBg}" Stroke="{DynamicResource CtlBorder}" StrokeThickness="1" />
                  <Ellipse Name="Dot" Width="7" Height="7" Fill="{DynamicResource GoldKnob}" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                <Border Width="15" Height="15" CornerRadius="4" Background="{DynamicResource CtlBg}" BorderBrush="{DynamicResource CtlBorder}" BorderThickness="1" VerticalAlignment="Center">
                  <Canvas Name="Mark" Width="11" Height="11" Visibility="Collapsed">
                    <Path Data="M2.2,5.5 L4.7,8 L8.8,2.75" Stroke="{DynamicResource GoldIcon}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SliderFill" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Height="6" CornerRadius="3" Background="{TemplateBinding Control.Background}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type Slider}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Height="16">
                <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBg}" VerticalAlignment="Center" BorderThickness="0,1,0,0" BorderBrush="#E6000000" />
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource GoldFill}" Command="Slider.DecreaseLarge" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFill}" Background="#00FFFFFF" Command="Slider.IncreaseLarge" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="14" Height="14">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Ellipse Fill="{DynamicResource GoldKnob}">
                            <UIElement.Effect>
                              <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="2" Direction="270" Opacity="0.6" />
                            </UIElement.Effect>
                          </Ellipse>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="28" Background="{DynamicResource WinBg}" BorderThickness="1" BorderBrush="{DynamicResource WinBorder}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
      <Border CornerRadius="28" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource WinBevel}" IsHitTestVisible="False" />
      <Border CornerRadius="21" Margin="7" BorderThickness="1.5" BorderBrush="{DynamicResource WinRing}" IsHitTestVisible="False" />
      <DockPanel Margin="28,26" LastChildFill="False">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
          <Button Name="TabGeneralBtn" Content="General" Width="90" Style="{StaticResource GoldButton}" Click="ShowGeneralTab_Click" />
          <Button Name="TabHotkeysBtn" Content="Hotkeys" Width="90" Margin="10,0,0,0" Click="ShowHotkeysTab_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
          <Button Content="Close" Width="100" Click="Close_Click" />
          <Button Content="About elion" Width="130" Margin="10,0,0,0" Style="{StaticResource GoldButton}" Click="About_Click" />
        </StackPanel>
        <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="{DynamicResource SectionDivider}" Margin="0,18" />
        <StackPanel DockPanel.Dock="Top" Name="GeneralTab">
          <TextBlock Text="Toolbar Appearance" Style="{StaticResource SectionTitle}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Name="RbDark" Content="Dark" GroupName="ThemeMode" Margin="0,0,24,0" Checked="Theme_Changed" />
            <RadioButton Name="RbLight" Content="Light" GroupName="ThemeMode" Margin="0,0,24,0" Checked="Theme_Changed" />
            <RadioButton Name="RbOrbit" Content="Orbit" GroupName="ThemeMode" Checked="Theme_Changed" />
          </StackPanel>
          <TextBlock Text="Toolbar orientation" Style="{StaticResource FieldLabel}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Name="RbHorizontal" Content="Horizontal" GroupName="ToolbarOrientation" Margin="0,0,24,0" Checked="Orientation_Changed" />
            <RadioButton Name="RbVertical" Content="Vertical" GroupName="ToolbarOrientation" Checked="Orientation_Changed" />
          </StackPanel>
          <TextBlock Text="Panel opacity" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Transparent" Foreground="{DynamicResource HintText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider Name="OpacitySlider" Minimum="30" Maximum="100" Width="150" VerticalAlignment="Center" />
            <TextBlock Text="Solid" Foreground="{DynamicResource HintText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
          <Rectangle Height="1" Fill="{DynamicResource SectionDivider}" Margin="0,18" />
          <TextBlock Text="Screenshot" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Save location" Style="{StaticResource FieldLabel}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox Name="ScreenshotFolderBox" Width="260" IsReadOnly="True" Style="{StaticResource FieldBox}" />
            <Button Content="Choose folder..." Width="130" Margin="10,0,0,0" Click="PickFolder_Click" />
          </StackPanel>
          <TextBlock Text="Output format" Style="{StaticResource FieldLabel}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Name="RbPng" Content="PNG (lossless)" GroupName="ShotFormat" Margin="0,0,24,0" Checked="Format_Changed" />
            <RadioButton Name="RbJpeg" Content="JPEG (smaller size)" GroupName="ShotFormat" Checked="Format_Changed" />
          </StackPanel>
          <StackPanel Name="QualityPanel" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="JPEG quality:" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider Name="QualitySlider" Minimum="1" Maximum="100" Width="150" VerticalAlignment="Center" />
            <TextBlock Name="QualityLabel" Text="90" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Width="30" Margin="10,0,0,0" />
          </StackPanel>
          <CheckBox Name="AutoSaveCheck" Content="Save automatically without a dialog" Margin="0,0,0,4" Checked="AutoSave_Changed" Unchecked="AutoSave_Changed" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Name="HotkeysTab" Visibility="Collapsed">
          <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Click a shortcut, then press the new key combination." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,14" />
          <Grid Name="HotkeyRows">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource SectionDivider}" Margin="0,16" />
          <TextBlock Text="Exit shortcut (Ctrl+Alt+Q) is fixed and cannot be changed, so you can always quit." TextWrapping="Wrap" Foreground="{DynamicResource HintText}" FontSize="11" Margin="0,0,0,12" />
          <Button Content="Reset to defaults" Width="140" HorizontalAlignment="Left" Click="ResetHotkeys_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
