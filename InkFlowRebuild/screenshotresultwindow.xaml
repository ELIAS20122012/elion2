<Window x:Class="InkFlow.ScreenshotResultWindow" Icon="elion.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Screenshot" Height="380" Width="380" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" FontFamily="Segoe UI" xmlns:inkflow="clr-namespace:InkFlow;assembly=InkFlow">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#163838" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="14" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="#2E3542" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#C9A87C" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#122E2E" CornerRadius="20" BorderBrush="#2A5A5A" BorderThickness="1" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Screenshot captured" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
      <Border Grid.Row="1" Background="#000000" CornerRadius="10" Margin="0,0,0,14">
        <Image Name="PreviewImage" Stretch="Uniform" Margin="4" />
      </Border>
      <StackPanel Grid.Row="2" Orientation="Vertical">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
          <Button Content="Copy" Width="105" Style="{StaticResource PrimaryButton}" Click="Copy_Click" />
          <Button Content="Save..." Width="105" Margin="10,0,0,0" Click="Save_Click" />
          <Button Content="Both" Width="105" Margin="10,0,0,0" Click="Both_Click" />
        </StackPanel>
        <Button Content="Discard" HorizontalAlignment="Left" Width="90" Background="#00FFFFFF" Foreground="#999999" Click="Discard_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>