<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InkFlow</AssemblyName>
    <RootNamespace>InkFlow</RootNamespace>
    <ApplicationIcon>elion.ico</ApplicationIcon>
    <Company>elion grup</Company>
    <Product>elion</Product>
    <Title>elion</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="elion.ico" />
  </ItemGroup>
</Project>
