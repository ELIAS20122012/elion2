            <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
              <Path Data="M8,5 L4,9 L8,13 M4.5,9 L11.5,9 C15,9 17,11 17,15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M7.5,5.5 L3.5,9.5 L7.5,13.5 M3.5,9.5 L12,9.5 C15,9.5 17,11.5 17,14 C17,16 15.6,17.4 13.6,17.4" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
          </Button>
          <Button Style="{StaticResource IconButton}" ToolTip="Clear all (Ctrl+Shift+X)" AutomationProperties.Name="Clear all (Ctrl+Shift+X)" Click="Clear_Click">
            <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
              <Path Data="M4,6 L16,6 M8,3.5 L12,3.5 M6,6 L7,17 L13,17 L14,6 M9,9 L9,14 M11,9 L11,14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M15.5,2.5 L10.2,9.6 M7.2,9.6 L12.6,9.6 L14,17.5 L4.6,17.5 Z M7.6,12.6 L7,17.5 M10.4,12.6 L10.8,17.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
          </Button>
          <Button Name="BtnBoard" Style="{StaticResource IconButton}" ToolTip="Whiteboard / Blackboard (F10)" AutomationProperties.Name="Whiteboard / Blackboard (F10)" Click="BoardButton_Click">
            <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
              <Path Data="M2,3 L18,3 L18,16 L2,16 Z M5,8 L15,8 M5,12 L12,12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M10,1.8 L10,3.6 M3,3.6 L17,3.6 L17,13.4 L3,13.4 Z M10,13.4 L6.4,18.4 M10,13.4 L13.6,18.4 M6,7.4 L11,7.4 M6,10 L14,10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
          </Button>
          <Popup Name="BoardPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" PlacementTarget="{Binding ElementName=BtnBoard}">
            <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                <UIElement.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </UIElement.Effect>
              <Grid>
                <Border CornerRadius="9" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource PopupRing}" IsHitTestVisible="False" />
                <ContentControl Margin="5" Focusable="False"><StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Tag="White" ToolTip="Whiteboard" AutomationProperties.Name="Whiteboard" Click="BoardOption_Click">
                  <Border Width="17" Height="13" Background="#F4F1EA" CornerRadius="2" BorderBrush="#D4AF5F" BorderThickness="1" />
                </Button>
                <Button Style="{StaticResource IconButton}" Tag="Black" ToolTip="Blackboard" AutomationProperties.Name="Blackboard" Click="BoardOption_Click">
                  <Border Width="17" Height="13" Background="#0B0B0C" CornerRadius="2" BorderBrush="#D4AF5F" BorderThickness="1" />
                </Button>
                <Button Style="{StaticResource IconButton}" Tag="None" ToolTip="Off (transparent)" AutomationProperties.Name="Off (transparent)" Click="BoardOption_Click">
                  <Canvas Width="16" Height="16">
                    <Rectangle Width="16" Height="16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                    <Line X1="2" Y1="2" X2="14" Y2="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" />
                  </Canvas>
                </Button>
              </StackPanel></ContentControl>
              </Grid>
            </Border>
          </Popup>
          <Button Name="BtnScreenshot" Style="{StaticResource IconButton}" ToolTip="Screenshot (F11)" AutomationProperties.Name="Screenshot (F11)" Click="ScreenshotButton_Click">
            <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
              <Path Data="M2,7 L2,3 L6,3 M14,3 L18,3 L18,7 M18,13 L18,17 L14,17 M6,17 L2,17 L2,13" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              <Ellipse Canvas.Left="8" Canvas.Top="8" Width="4" Height="4" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" />
            </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M2,6.5 L2,2 L6.5,2 M13.5,2 L18,2 L18,6.5 M18,13.5 L18,18 L13.5,18 M6.5,18 L2,18 L2,13.5 M10,6 L14,10 L10,14 L6,10 Z" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
          </Button>
          <Popup Name="ScreenshotPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" PlacementTarget="{Binding ElementName=BtnScreenshot}">
            <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                <UIElement.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </UIElement.Effect>
              <Grid>
                <Border CornerRadius="9" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource PopupRing}" IsHitTestVisible="False" />
                <ContentControl Margin="5" Focusable="False"><StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" ToolTip="Full screen" AutomationProperties.Name="Full screen" Click="ScreenshotFull_Click">
                  <Canvas Width="18" Height="14">
                    <Rectangle Width="18" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" RadiusX="1.5" RadiusY="1.5" />
                  </Canvas>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Select area" AutomationProperties.Name="Select area" Click="ScreenshotRegion_Click">
                  <Canvas Width="18" Height="14">
                    <Rectangle Width="18" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" StrokeDashArray="2,1.5" RadiusX="1" RadiusY="1" />
                    <Rectangle Canvas.Left="4" Canvas.Top="3" Width="10" Height="8" Fill="#D4AF5F" Opacity="0.55" />
                  </Canvas>
                </Button>
              </StackPanel></ContentControl>
              </Grid>
            </Border>
          </Popup>
          <Rectangle Style="{StaticResource Divider}" />
          <Button Name="BtnPauseExit" Style="{StaticResource IconButton}" ToolTip="Click: pause &amp; collapse | Hold: exit" PreviewMouseLeftButtonDown="PauseExit_MouseLeftButtonDown" PreviewMouseLeftButtonUp="PauseExit_MouseLeftButtonUp">
            <Grid Width="18" Height="18">
              <Canvas Name="PauseIcon" Width="18" Height="18">
                <Line X1="6" Y1="3" X2="6" Y2="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="12" Y1="3" X2="12" Y2="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
              <Polygon Name="PlayIcon" Points="0,0 0,15 13,7.5" Fill="{DynamicResource IconBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Rectangle Style="{StaticResource Divider}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsButton_Click">
            <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
              <Path Data="M10,2 L10,4 M10,16 L10,18 M2,10 L4,10 M16,10 L18,10 M4.35,4.35 L5.75,5.75 M14.25,14.25 L15.65,15.65 M15.65,4.35 L14.25,5.75 M5.75,14.25 L4.35,15.65" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Ellipse Canvas.Left="4" Canvas.Top="4" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" Fill="#00FFFFFF" />
              <Ellipse Canvas.Left="8" Canvas.Top="8" Width="4" Height="4" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="#00FFFFFF" />
            </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M10,1.5 L11.6,8.4 L18.5,10 L11.6,11.6 L10,18.5 L8.4,11.6 L1.5,10 L8.4,8.4 Z M10,4.5 L10,15.5 M4.5,10 L15.5,10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
          </Button>
        </StackPanel>
        <Border CornerRadius="22" BorderThickness="0,1,0,1" IsHitTestVisible="False">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#12FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="0.3" />
              <GradientStop Color="#00C9A24E" Offset="0.7" />
              <GradientStop Color="#47C9A24E" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
        </Border>
      </Grid>
    </Border>
    <Border Name="MiniBar" Visibility="Collapsed" Background="{StaticResource MiniBg}" CornerRadius="17" Width="34" Height="34" BorderBrush="#8CD4AF5F" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTip="Show toolbar (drag to move)" MouseLeftButtonDown="MiniBar_MouseLeftButtonDown">
      <Grid IsHitTestVisible="False"><Canvas Width="20" Height="20" IsHitTestVisible="False" Visibility="{DynamicResource ClassicVis}">
        <Path Data="M4,16 L5.5,11.5 L14.5,2.5 L17.5,5.5 L8.5,14.5 M5.5,11.5 L8.5,14.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M10,1.8 C12.6,4.8 15.4,8 14.6,11.4 L10,18.4 L5.4,11.4 C4.6,8 7.4,4.8 10,1.8 Z M10,18.4 L10,10.6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Ellipse Canvas.Left="8.6" Canvas.Top="7.4" Width="2.8" Height="2.8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.2" /></Canvas></Grid>
    </Border>
  </Grid>
</Window>