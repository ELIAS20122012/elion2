            <Button Name="BtnPenGroup" Style="{StaticResource IconButton}" ToolTip="Pen / Arrow" AutomationProperties.Name="Pen / Arrow" Click="PenGroupButton_Click">
              <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
                <Path Data="M4,16 L5.5,11.5 L14.5,2.5 L17.5,5.5 L8.5,14.5 M5.5,11.5 L8.5,14.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M10,1.8 C12.6,4.8 15.4,8 14.6,11.4 L10,18.4 L5.4,11.4 C4.6,8 7.4,4.8 10,1.8 Z M10,18.4 L10,10.6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Ellipse Canvas.Left="8.6" Canvas.Top="7.4" Width="2.8" Height="2.8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.2" /></Canvas></Grid>
            </Button>
            <Popup Name="PenGroupPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" PlacementTarget="{Binding ElementName=BtnPenGroup}">
              <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                <UIElement.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </UIElement.Effect>
                <Grid>
                <Border CornerRadius="9" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource PopupRing}" IsHitTestVisible="False" />
                <ContentControl Margin="5" Focusable="False"><StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource IconButton}" Tag="Pen" ToolTip="Pen" AutomationProperties.Name="Pen" Click="PenGroupOption_Click">
                    <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
                      <Path Data="M4,16 L5.5,11.5 L14.5,2.5 L17.5,5.5 L8.5,14.5 M5.5,11.5 L8.5,14.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M10,1.8 C12.6,4.8 15.4,8 14.6,11.4 L10,18.4 L5.4,11.4 C4.6,8 7.4,4.8 10,1.8 Z M10,18.4 L10,10.6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Ellipse Canvas.Left="8.6" Canvas.Top="7.4" Width="2.8" Height="2.8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.2" /></Canvas></Grid>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Tag="Arrow" ToolTip="Arrow" AutomationProperties.Name="Arrow" Click="PenGroupOption_Click">
                    <Grid><Canvas Width="21" Height="18" Visibility="{DynamicResource ClassicVis}">
                      <Path Data="M2,15 L18,2 M10.5,2 L18,2 L18,9.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M4.5,16 L16.5,4 M10.5,4 L16.5,4 L16.5,10 M2.5,18 L4.5,16 M3,15 L5.5,17.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
                  </Button>
                </StackPanel></ContentControl>
              </Grid>
            </Border>
            </Popup>
            <Button Name="BtnText" Style="{StaticResource IconButton}" ToolTip="Text" AutomationProperties.Name="Text" Click="Tool_Click">
              <Grid><TextBlock Text="T" Foreground="{DynamicResource IconBrush}" FontFamily="Segoe UI" FontSize="19" FontWeight="Light" Margin="0,-2,0,0" Visibility="{DynamicResource ClassicVis}" /><TextBlock Text="T" Foreground="{DynamicResource IconBrush}" FontFamily="Georgia" FontStyle="Italic" FontSize="17" Margin="0,-1,0,0" Visibility="{DynamicResource LuxVis}" /></Grid>
            </Button>
            <Button Name="BtnEraser" Style="{StaticResource IconButton}" ToolTip="Eraser" AutomationProperties.Name="Eraser" Click="Tool_Click">
              <Grid><Canvas Width="20" Height="20" Visibility="{DynamicResource ClassicVis}">
                <Path Data="M4,13 L11,4 C11.8,3.2 12.8,3.2 13.6,4 L17,7.4 C17.8,8.2 17.8,9.2 17,10 L11,16 L6,16 M10.8,16 L17.5,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas><Canvas Width="20" Height="20" Visibility="{DynamicResource LuxVis}"><Path Data="M4.5,13.5 L11.5,6.5 L15.5,10.5 L10.5,15.5 L6.5,15.5 Z M9,9 L13,13 M3,17.8 L17,17.8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Grid>
            </Button>
          </StackPanel>
          <Rectangle Style="{StaticResource Divider}" />
          <Button Name="BtnColor" Style="{StaticResource IconButton}" ToolTip="Pen color" AutomationProperties.Name="Pen color" Click="ColorButton_Click">
            <Ellipse Name="ColorButtonFill" Width="16" Height="16" Fill="#FFE53935" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" />
          </Button>
          <Popup Name="ColorPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" PlacementTarget="{Binding ElementName=BtnColor}">
            <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                <UIElement.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </UIElement.Effect>
              <Grid>
                <Border CornerRadius="9" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource PopupRing}" IsHitTestVisible="False" />
                <ContentControl Margin="10" Focusable="False"><StackPanel Orientation="Vertical">
                <UniformGrid Rows="2" Columns="6">
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF000000" ToolTip="Black" AutomationProperties.Name="Black" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#000000" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF808080" ToolTip="Gray" AutomationProperties.Name="Gray" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#808080" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFE53935" ToolTip="Red" AutomationProperties.Name="Red" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#E53935" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFFB8C00" ToolTip="Orange" AutomationProperties.Name="Orange" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#FB8C00" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFFDD835" ToolTip="Yellow" AutomationProperties.Name="Yellow" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#FDD835" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF43A047" ToolTip="Green" AutomationProperties.Name="Green" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#43A047" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF00ACC1" ToolTip="Teal" AutomationProperties.Name="Teal" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#00ACC1" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF1E88E5" ToolTip="Blue" AutomationProperties.Name="Blue" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#1E88E5" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FF8E24AA" ToolTip="Purple" AutomationProperties.Name="Purple" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#8E24AA" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFD81B60" ToolTip="Magenta" AutomationProperties.Name="Magenta" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#D81B60" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFF06292" ToolTip="Pink" AutomationProperties.Name="Pink" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#F06292" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="#FFFFFFFF" ToolTip="White" AutomationProperties.Name="White" Click="PresetColor_Click">
                    <Ellipse Width="15" Height="15" Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1" />
                  </Button>
                </UniformGrid>
                <Rectangle Height="1" Fill="{DynamicResource DividerH}" Margin="2,9" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Custom color..." AutomationProperties.Name="Custom color..." Click="CustomColor_Click">
                    <Canvas Width="20" Height="20"><Path Data="M10,4 L10,16 M4,10 L16,10" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="6,0,0,0" ToolTip="Pick color from screen" AutomationProperties.Name="Pick color from screen" Click="Eyedropper_Click">
                    <Canvas Width="18" Height="18">
                      <Path Data="M4,14 L13.5,4.5 M11.5,2.5 L15.5,6.5 M3,15 L6,15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" Fill="#00FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Ellipse Canvas.Left="1.5" Canvas.Top="13.5" Width="3" Height="3" Fill="#F0D690" />
                    </Canvas>
                  </Button>
                </StackPanel>
              </StackPanel></ContentControl>
              </Grid>
            </Border>
          </Popup>
          <Button Name="BtnThickness" Style="{StaticResource IconButton}" ToolTip="Pen thickness" AutomationProperties.Name="Pen thickness" Click="ThicknessButton_Click">
            <Canvas Width="22" Height="22">
              <Line X1="5" Y1="7" X2="17" Y2="7" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Line Name="ThicknessPreviewLine" X1="3" Y1="14" X2="19" Y2="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Button>
          <Popup Name="ThicknessPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" PlacementTarget="{Binding ElementName=BtnThickness}">
            <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                <UIElement.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </UIElement.Effect>
              <Grid>
                <Border CornerRadius="9" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource PopupRing}" IsHitTestVisible="False" />
