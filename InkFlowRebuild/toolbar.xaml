<Window x:Class="InkFlow.Toolbar" Icon="elion.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="elion Toolbar" Height="42" Width="362" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" AllowsTransparency="True" Background="#00FFFFFF" WindowStartupLocation="Manual" xmlns:inkflow="clr-namespace:InkFlow;assembly=InkFlow" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- elion Gold theme -->
      <LinearGradientBrush x:Key="IconBrush" MappingMode="Absolute" StartPoint="0,1" EndPoint="0,19">
        <GradientStop Color="#F6E2A6" Offset="0" />
        <GradientStop Color="#D4AF5F" Offset="0.5" />
        <GradientStop Color="#9A7333" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GoldBrush" Color="#D4AF5F" />
      <SolidColorBrush x:Key="AccentBrush" Color="#D4AF5F" />
      <SolidColorBrush x:Key="DangerColor" Color="#E5484D" />
      <LinearGradientBrush x:Key="Panel3D" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C2E34" Offset="0" />
        <GradientStop Color="#222428" Offset="0.5" />
        <GradientStop Color="#1A1B1F" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BtnRaised" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B3E45" Offset="0" />
        <GradientStop Color="#2B2D33" Offset="0.55" />
        <GradientStop Color="#222429" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BtnBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.2" />
        <GradientStop Color="#00C9A24E" Offset="0.8" />
        <GradientStop Color="#66C9A24E" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PopupBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2C31" Offset="0" />
        <GradientStop Color="#1E2024" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="PopupBorderBrush" Color="#3A3D44" />
      <SolidColorBrush x:Key="PopupRing" Color="#00000000" />
      <SolidColorBrush x:Key="ActiveBrush" Color="#D4AF5F" />
      <sys:Double x:Key="BtnSize">25</sys:Double>
      <CornerRadius x:Key="BtnCorner">8</CornerRadius>
      <CornerRadius x:Key="BtnCornerOuter">8</CornerRadius>
      <CornerRadius x:Key="RingCorner">6</CornerRadius>
      <Thickness x:Key="BtnBorderThickness">1</Thickness>
      <Thickness x:Key="ActiveMargin">0</Thickness>
      <Visibility x:Key="HaloVis">Collapsed</Visibility>
      <Visibility x:Key="ClassicVis">Visible</Visibility>
      <SolidColorBrush x:Key="HaloOuter" Color="#3D3F45" />
      <SolidColorBrush x:Key="HaloInner" Color="#26272B" />
      <Visibility x:Key="LuxVis">Collapsed</Visibility>
      <SolidColorBrush x:Key="BtnBorder" Color="#00000000" />
      <SolidColorBrush x:Key="BtnRing" Color="#00000000" />
      <SolidColorBrush x:Key="BarBorder" Color="#00000000" />
      <SolidColorBrush x:Key="BarRing" Color="#00000000" />
      <DropShadowEffect x:Key="BtnShadow" Color="#000000" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.6" />
      <DropShadowEffect x:Key="IconShadow" Color="#000000" BlurRadius="0" ShadowDepth="0" Opacity="0" />
      <LinearGradientBrush x:Key="DividerV" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00D4AF5F" Offset="0" />
        <GradientStop Color="#73D4AF5F" Offset="0.5" />
        <GradientStop Color="#00D4AF5F" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="DividerH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D4AF5F" Offset="0" />
        <GradientStop Color="#73D4AF5F" Offset="0.5" />
        <GradientStop Color="#00D4AF5F" Offset="1" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="DotBrush" GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#5A5D66" Offset="0" />
        <GradientStop Color="#101114" Offset="1" />
      </RadialGradientBrush>
      <RadialGradientBrush x:Key="MiniBg" GradientOrigin="0.4,0.3" Center="0.4,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#3F424A" Offset="0" />
        <GradientStop Color="#1D1F23" Offset="1" />
      </RadialGradientBrush>
      <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{DynamicResource BtnSize}" />
        <Setter Property="Height" Value="{DynamicResource BtnSize}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BtnRaised}" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="Root" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </UIElement.RenderTransform>
                <Border Margin="-2" CornerRadius="{DynamicResource BtnCornerOuter}" Background="{DynamicResource HaloOuter}" Visibility="{DynamicResource HaloVis}" IsHitTestVisible="False">
                  <Border Margin="1" CornerRadius="{DynamicResource BtnCornerOuter}" Background="{DynamicResource HaloInner}" />
                </Border>
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="{DynamicResource BtnCorner}" BorderThickness="{DynamicResource BtnBorderThickness}" BorderBrush="{DynamicResource BtnBorder}" Effect="{DynamicResource BtnShadow}" />
                <Border CornerRadius="{DynamicResource BtnCorner}" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource BtnBevel}" IsHitTestVisible="False" />
                <Border CornerRadius="{DynamicResource RingCorner}" Margin="2.5" BorderThickness="0.8" BorderBrush="{DynamicResource BtnRing}" IsHitTestVisible="False" />
                <Border Name="Hi" CornerRadius="{DynamicResource BtnCorner}" Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource IconShadow}" />
                <Border CornerRadius="{DynamicResource BtnCornerOuter}" Margin="{DynamicResource ActiveMargin}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" IsHitTestVisible="False">
                  <UIElement.Effect>
                    <DropShadowEffect Color="#D4AF5F" BlurRadius="6" ShadowDepth="0" Opacity="0.35" />
                  </UIElement.Effect>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Hi" Property="Opacity" Value="1" />
                  <Setter TargetName="Root" Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="1.07" ScaleY="1.07" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Divider" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource DividerV}" />
        <Setter Property="Margin" Value="2,8" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border Name="FullBar" CornerRadius="22" Background="{StaticResource Panel3D}" BorderThickness="1" BorderBrush="{DynamicResource BarBorder}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
      <Grid>
        <Border CornerRadius="19" Margin="2" BorderThickness="1" BorderBrush="{DynamicResource BarRing}" IsHitTestVisible="False" />
        <Border Name="AccentRail" Width="2" Height="44" CornerRadius="1" Visibility="Collapsed" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />
        <StackPanel Name="MainPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas Name="DragHandle" Width="16" Height="24" Cursor="SizeAll" Margin="2,0,1,0">
            <Ellipse Canvas.Left="2.25" Canvas.Top="3" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
            <Ellipse Canvas.Left="9.75" Canvas.Top="3" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
            <Ellipse Canvas.Left="2.25" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
            <Ellipse Canvas.Left="9.75" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
            <Ellipse Canvas.Left="2.25" Canvas.Top="17" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
            <Ellipse Canvas.Left="9.75" Canvas.Top="17" Width="4" Height="4" Fill="{DynamicResource DotBrush}" />
          </Canvas>
          <Rectangle Style="{StaticResource Divider}" />
