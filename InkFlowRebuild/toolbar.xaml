                <Button Style="{StaticResource IconButton}" Width="28" Tag="2" ToolTip="2px" AutomationProperties.Name="2px" Click="ThicknessOption_Click">
                  <Line X1="2" Y1="0" X2="18" Y2="0" Stroke="{DynamicResource IconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="28" Tag="4" ToolTip="4px" AutomationProperties.Name="4px" Click="ThicknessOption_Click">
                  <Line X1="2" Y1="0" X2="18" Y2="0" Stroke="{DynamicResource IconBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="28" Tag="6" ToolTip="6px" AutomationProperties.Name="6px" Click="ThicknessOption_Click">
                  <Line X1="2" Y1="0" X2="18" Y2="0" Stroke="{DynamicResource IconBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="28" Tag="8" ToolTip="8px" AutomationProperties.Name="8px" Click="ThicknessOption_Click">
                  <Line X1="2" Y1="0" X2="18" Y2="0" Stroke="{DynamicResource IconBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
              </StackPanel></ContentControl>
              </Grid>
            </Border>
          </Popup>
          <Rectangle Style="{StaticResource Divider}" />
